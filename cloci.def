# Apptainer definition, kept in sync with the Dockerfile.
# Build under SLURM with ./pull_sif.sh (or pull the CI image: see README).
Bootstrap: docker
From: ubuntu:22.04

%arguments
    PIXI_VERSION=0.71.3
    CLOCI_REPO=https://github.com/hyphaltip/cloci.git
    MYCOTOOLS_REPO=https://github.com/hyphaltip/mycotools.git
    CLOCI_REF=2ca41914792abe64e87e38f3cb9dca63763f2f71
    MYCOTOOLS_REF=3b0bac55e2e15b44d3753ed130c4776ef4b463d7

%files
    pixi.toml /opt/cloci/pixi.toml

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential procps
    rm -rf /var/lib/apt/lists/*

    export PIXI_HOME=/opt/pixi
    curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v{{ PIXI_VERSION }} PIXI_NO_PATH_UPDATE=1 bash
    export PATH=/opt/pixi/bin:$PATH

    cd /opt/cloci
    mkdir src
    git clone {{ MYCOTOOLS_REPO }} src/mycotools
    git -C src/mycotools checkout {{ MYCOTOOLS_REF }}
    git clone {{ CLOCI_REPO }} src/cloci
    git -C src/cloci checkout {{ CLOCI_REF }}
    pixi install
    pixi clean cache -y
    rm -rf /root/.cache

%environment
    export PATH=/opt/cloci/.pixi/envs/default/bin:$PATH
    export CONDA_PREFIX=/opt/cloci/.pixi/envs/default
    export LC_ALL=C.UTF-8
    export MPLCONFIGDIR=/tmp/matplotlib

%test
    cloci --help >/dev/null
    mtdb --help >/dev/null
    python -c "import cloci, mycotools, graph_tool, cogent3"
    which mmseqs diamond hmmsearch mafft clipkit iqtree fasttree mcl

%runscript
    exec "$@"

%labels
    Software cloci
    Source https://github.com/hyphaltip/cloci_container
